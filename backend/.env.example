PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HEALTH_TIMEOUT_MS=3000
# Maximum file bytes; frontend preview has its own 10 MiB limit.
MAX_UPLOAD_BYTES=10485760
