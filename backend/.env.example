PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HEALTH_TIMEOUT_MS=30000
# Dedicated stylization request timeout, including response body (1..2147483647 ms).
AI_STYLIZATION_TIMEOUT_MS=900000
# Optional separate SD15 service; defaults to AI_SERVICE_URL when unset.
# Separate processes allow isolating SCHP and SD15; manage model memory explicitly.
# AI_STYLIZATION_SERVICE_URL=http://127.0.0.1:8001
# Maximum file bytes; frontend preview has its own 10 MiB limit.
MAX_UPLOAD_BYTES=10485760
# Maximum number of pending extraction/stylization tasks waiting in the FIFO queue (>= 1).
MAX_QUEUE_LENGTH=10
# Automatic storage retention for expired jobs and unreferenced uploads (hours; 0 disables).
# When enabled (>0), must exceed AI_STYLIZATION_TIMEOUT_MS.
STORAGE_RETENTION_HOURS=24
# Periodic retention sweep interval in minutes (0 disables periodic timer; initial sweep still runs if retention > 0).
STORAGE_SWEEP_INTERVAL_MINUTES=60
# Optional private directory. Default: storage/uploads at the project root.
# Relative paths are resolved from the backend working directory.
# UPLOAD_DIR=D:/private/immoextract/uploads
